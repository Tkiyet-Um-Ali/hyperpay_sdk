# --- Backend (recommended): your server creates HyperPay checkouts ---
TUA_API_BASE_URL=https://api-dev.tua.jo
# Short-lived access token + refresh token (client: mobile). Rotated tokens
# are stored on the device; paste a fresh pair here to reset them.
TUA_ACCESS_TOKEN=your_access_token_here
TUA_REFRESH_TOKEN=your_refresh_token_here
# First Idempotency-Key; it changes after every finished payment.
TUA_IDEMPOTENCY_KEY=
# POST /v1/donations/checkout body
TUA_PROGRAM_SLUG=your_program_slug
TUA_PROGRAM_VERSION=2026-01-01T00:00:00.000Z
TUA_OPTION_ID=your_option_id
TUA_QUANTITY=1
TUA_PROFILE_ID=your_profile_id
TUA_CURRENCY=JOD
TUA_RECEIPT_EMAIL=
TUA_BILLING_COUNTRY=JO
TUA_BILLING_CITY=Amman
TUA_BILLING_STREET=12 Rainbow Street

# --- Optional, TEST ONLY: direct HyperPay REST access ---
# Only the saved-cards and "save card without paying" demos use these.
# Never ship a HyperPay access token in a real app.
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=

# Optional: wallet buttons on the TUA checkout screen (shown only when the
# checkout offers APPLEPAY / GOOGLEPAY)
TUA_APPLE_PAY_MERCHANT_ID=
TUA_GOOGLE_PAY_GATEWAY_MERCHANT_ID=
